# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# URL canonico dell’app (senza barra finale): usato nei link di conferma e recupero
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obbligatorie prima di raccogliere vere domande di adesione:
STATUTO_VERSION=
PRIVACY_VERSION=
NEXT_PUBLIC_STATUTO_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Solo server: true abilita il collaudo per TUTTI gli account autenticati.
# Prima dell’apertura al pubblico, impostare false o rimuovere la variabile.
SESTO_TEST_MODE=false

# SOLO SERVER: gestione utenti Auth e cron. Configurare su Vercel, mai nel repository.
SUPABASE_SERVICE_ROLE_KEY=

# 3.1 structural read snapshots: disabled by default. Server-only; never NEXT_PUBLIC_.
SC_STRUCTURAL_RPC=false
SC_STRUCTURAL_RPC_RELEASE=false
# Only after approval, both migrations and isolated staging verification:
# SC_STRUCTURAL_RPC_RELEASE_ENV=preview
# SC_STRUCTURAL_RPC_RELEASE_PROJECT_REF=<exact 20-character project ref>
# VERCEL_ENV is supplied by Vercel; do not override it to bypass the gate.
