# Supabase > Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# URL canonico dell’app (senza barra finale): usato nei link di conferma e recupero
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Obbligatorie prima di raccogliere vere domande di adesione:
STATUTO_VERSION=
PRIVACY_VERSION=
NEXT_PUBLIC_STATUTO_URL=
NEXT_PUBLIC_PRIVACY_URL=

# Opzionale: UUID Auth di account di collaudo, separati da virgola. Solo server.
SESTO_TEST_USER_IDS=
